---
import Layout from '../layouts/Layout.astro';
---
<Layout title="About" page="about">
<section class="page-hero">
  <img src="/images/workshop.jpg" alt="Workshop" class="page-hero__bg" />
  <div class="page-hero__overlay"></div>
  <div class="container page-hero__content">
    <div class="section-badge reveal"><span class="section-badge__num">00</span><span class="section-badge__line"></span><span class="section-badge__label">Our Story</span></div>
    <h1 class="t-headline reveal">Built for<br/><span class="text-gradient">Speed.</span></h1>
  </div>
</section>

<section class="section" style="background:var(--dark)">
  <div class="container">
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:5rem;align-items:center" class="about-grid">
      <div>
        <div class="section-badge reveal"><span class="section-badge__num">01</span><span class="section-badge__line"></span><span class="section-badge__label">Who We Are</span></div>
        <h2 class="t-headline reveal" style="margin-bottom:1.5rem">Engineering <span class="text-gradient">Passion</span></h2>
        <p class="t-body reveal" style="margin-bottom:1.5rem">Lightsquad Motorsports was born from a deep love of speed, engineering, and the rush of competition. We manufacture world-class go-karts, ATVs, UTVs, and lightweight racing cars — built to dominate every terrain.</p>
        <p class="t-body reveal" style="margin-bottom:2rem">From our workshop to the racetrack, every machine we build carries the soul of motorsport — precise, powerful, and built to push limits.</p>
        <div style="display:flex;gap:1rem;flex-wrap:wrap" class="reveal">
          <a href="/services" class="btn btn-primary">Our Services</a>
          <a href="/contact" class="btn btn-outline">Get in Touch</a>
        </div>
      </div>
      <div style="display:grid;grid-template-columns:1fr 1fr;gap:1rem" class="reveal-right">
        <div style="background:var(--dark-card);border:1px solid var(--dark-border);border-radius:var(--radius-lg);padding:2rem;text-align:center">
          <div style="font-family:var(--font-display);font-size:3rem;font-weight:900;color:var(--orange)" data-counter="8" data-suffix="+">8+</div>
          <div class="t-label" style="margin-top:.5rem">Years Building</div>
        </div>
        <div style="background:var(--dark-card);border:1px solid var(--dark-border);border-radius:var(--radius-lg);padding:2rem;text-align:center">
          <div style="font-family:var(--font-display);font-size:3rem;font-weight:900;color:var(--orange)" data-counter="500" data-suffix="+">500+</div>
          <div class="t-label" style="margin-top:.5rem">Machines Built</div>
        </div>
        <div style="background:var(--dark-card);border:1px solid var(--dark-border);border-radius:var(--radius-lg);padding:2rem;text-align:center">
          <div style="font-family:var(--font-display);font-size:3rem;font-weight:900;color:var(--orange)" data-counter="200" data-suffix="+">200+</div>
          <div class="t-label" style="margin-top:.5rem">Events Hosted</div>
        </div>
        <div style="background:var(--dark-card);border:1px solid var(--dark-border);border-radius:var(--radius-lg);padding:2rem;text-align:center">
          <div style="font-family:var(--font-display);font-size:3rem;font-weight:900;color:var(--orange)" data-counter="3000" data-suffix="+">3000+</div>
          <div class="t-label" style="margin-top:.5rem">Happy Riders</div>
        </div>
      </div>
    </div>
  </div>
</section>

<section class="section" style="background:var(--black)">
  <div class="container">
    <div class="section-badge reveal" style="justify-content:center"><span class="section-badge__num">02</span><span class="section-badge__line"></span><span class="section-badge__label">Our Values</span></div>
    <h2 class="t-headline text-center reveal" style="margin-bottom:3rem">What Drives <span class="text-gradient">Us</span></h2>
    <div class="grid-4">
      {[
        {icon:'⚡',title:'Innovation',desc:'Pushing boundaries in motorsport engineering with cutting-edge design and fabrication.'},
        {icon:'🏆',title:'Performance',desc:'Every machine is engineered for maximum output, precision handling, and race-ready performance.'},
        {icon:'🛡️',title:'Safety',desc:'World-class safety standards built into every vehicle and event we manage.'},
        {icon:'🌍',title:'Adventure',desc:'We create experiences that ignite passion and bring people together through motorsport.'}
      ].map(v => (
        <div class="card reveal" style="padding:2rem;text-align:center">
          <div style="font-size:2.5rem;margin-bottom:1rem">{v.icon}</div>
          <h3 class="t-title" style="margin-bottom:.75rem;color:var(--orange)">{v.title}</h3>
          <p style="font-size:.875rem;color:var(--grey);line-height:1.6">{v.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<section class="section" style="background:var(--dark)">
  <div class="container">
    <div class="section-badge reveal" style="justify-content:center"><span class="section-badge__num">03</span><span class="section-badge__line"></span><span class="section-badge__label">Mission & Vision</span></div>
    <div style="display:grid;grid-template-columns:1fr 1fr;gap:3rem;margin-top:2rem">
      <div class="card reveal" style="padding:2.5rem">
        <div class="accent-line"></div>
        <h3 class="t-title" style="margin-bottom:1rem">Our <span class="text-gradient">Mission</span></h3>
        <p class="t-body">To democratise motorsport in Nigeria and beyond — making world-class racing machines, experiences, and events accessible to enthusiasts of all levels.</p>
      </div>
      <div class="card reveal" style="padding:2.5rem">
        <div class="accent-line"></div>
        <h3 class="t-title" style="margin-bottom:1rem">Our <span class="text-gradient">Vision</span></h3>
        <p class="t-body">To become Africa&apos;s premier motorsport brand — manufacturing the continent&apos;s finest performance machines and hosting events that rival the world stage.</p>
      </div>
    </div>
  </div>
</section>

<section class="section--sm" style="background:linear-gradient(135deg,#0f0f0f,#1a0800,#0f0f0f);text-align:center;border-top:1px solid rgba(255,106,0,.15);border-bottom:1px solid rgba(255,106,0,.15)">
  <div class="container">
    <h2 class="t-headline reveal" style="margin-bottom:1rem">Ready to <span class="text-gradient">Race?</span></h2>
    <p class="t-body reveal" style="max-width:500px;margin:0 auto 2rem">Join thousands of riders who trust Lightsquad Motorsports for their racing adventures.</p>
    <div style="display:flex;gap:1rem;justify-content:center;flex-wrap:wrap" class="reveal">
      <a href="/book" class="btn btn-primary btn-lg">Book a Ride</a>
      <a href="/shop" class="btn btn-outline btn-lg">Shop Machines</a>
    </div>
  </div>
</section>
</Layout>

<style>
@media(max-width:768px){.about-grid{grid-template-columns:1fr!important;gap:2rem!important}}
</style>
